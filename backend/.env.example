# Copy to backend/.env and fill in. Never commit backend/.env.

# Signs login tokens and derives the env-var encryption key. At least 32 bytes.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
PAAS_SECRET_KEY=

# Apps are served at http://<name>-<userid>.<DOMAIN>
DOMAIN=localhost

# The dashboard origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# Shared secret you paste into the GitHub webhook settings
# python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# Public URL of this API (shown in the UI as the webhook URL, e.g. your tunnel URL)
PUBLIC_API_URL=http://localhost:8000
